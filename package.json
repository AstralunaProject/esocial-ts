{
  "name": "esocial-ts",
  "version": "0.1.1",
  "description": "Biblioteca Node.js/TypeScript para o eSocial: gera, valida no XSD, assina (XMLDSig RSA-SHA256) e envia eventos do leiaute S-1.3.",
  "type": "module",
  "author": "AstralunaProject",
  "license": "MIT",
  "homepage": "https://github.com/AstralunaProject/esocial-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstralunaProject/esocial-ts.git"
  },
  "bugs": {
    "url": "https://github.com/AstralunaProject/esocial-ts/issues"
  },
  "keywords": [
    "esocial",
    "esocial-nodejs",
    "esocial-typescript",
    "s-1.3",
    "xml",
    "xmldsig",
    "assinatura-digital",
    "assinatura-xml",
    "certificado-digital",
    "certificado-a1",
    "icp-brasil",
    "xsd",
    "folha-de-pagamento",
    "sped",
    "cnpj-alfanumerico",
    "brasil",
    "brazil"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "eventos": "node --experimental-strip-types scripts/eventos.ts",
    "check": "npm run typecheck && npm test && npm run eventos -- --check && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "node-forge": "^1.4.2",
    "xml-crypto": "^6.4.0",
    "xmllint-wasm": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/node-forge": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
